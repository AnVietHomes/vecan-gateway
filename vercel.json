{
  "redirects": [
    {
      "source": "/RadissonCollection",
      "destination": "/RadissonCollection/",
      "permanent": true
    },
    {
      "source": "/Primabay",
      "destination": "/Primabay/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/RadissonCollection/(.*)",
      "destination": "https://anviethomes.github.io/RadissonCollection/$1"
    },
    {
      "source": "/Primabay/(.*)",
      "destination": "https://vecan-tudong-prima.vercel.app/$1"
    }
  ]
}
